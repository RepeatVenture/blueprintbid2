# Public canonical URL; local default. Change for staging/production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Hosted mode needs both. Public browser-safe project key, NEVER a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only Stripe test credentials; leave empty to disable billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
# Server-only privileged key, used ONLY for verified billing webhooks.
SUPABASE_SERVICE_ROLE_KEY=
# Visual drawing analysis. Server-only. Disabled until the owner opts in to paid processing.
VISION_ENABLED=false
OPENAI_API_KEY=
# Explicit model ID with PDF/image input and Structured Outputs support; no guessed default.
OPENAI_VISION_MODEL=
